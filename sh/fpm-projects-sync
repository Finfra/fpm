#!/usr/bin/env python3
"""fpm-projects-sync — Projects.md(SSOT) 일괄 반영 통합 드라이버.

Q1=수동 단일 명령 진입점. Projects.md 편집 후 `fpm-projects-sync` 1회 실행.
3단계:
  [1/4] projects/<id> 경로 인덱스 재생성 (cdf 계열용)
  [2/4] 각 프로젝트 .vscode/settings.json 배경색(peacock) + window.title 이모지 반영
  [3/4] sh/update-iterm-bg 호출 (iterm-bg alias 재생성)
  [4/4] sh/fpm-identity-collect 호출 (Identity.md 아이덴티티 집계 재생성 — Issue472)

SSOT: $FPM_BASE/Projects.md 의 "📋 프로젝트" 표 (id / 경로 / 이모지 / color).
설치 위치 무관 동작: FPM_BASE(env) 우선, 없으면 본 스크립트 위치(sh/의 상위)로 self-detect.
"""
import json
import os
import re
import subprocess
import sys

PM_ROOT      = os.environ.get('FPM_BASE') or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROJECTS_MD  = os.path.join(PM_ROOT, 'Projects.md')
PROJECTS_DIR = os.path.join(PM_ROOT, 'projects')
UPDATE_ITERM = os.path.join(PM_ROOT, 'sh', 'update-iterm-bg')
IDENTITY_COL = os.path.join(PM_ROOT, 'sh', 'fpm-identity-collect')

# 프로젝트 id 정본 패턴 (Issue303): 정수 | 정수+소문자 | 정수+소문자+정수
#   9 / 9a / 9a1 — 접미는 "9 의 하위 프로젝트" 소속만 나타냄.
#   하이픈은 cdf 범위 문법(11-16)에 예약, 점은 정규식 메타문자라 둘 다 배제.
#   설계 SSOT: _doc_arch/project-id-scheme.md
PID_RE = re.compile(r'^([0-9]+)(?:([a-z])([0-9]*))?$')


def pid_sort_key(pid):
    """id 정렬키 — (정수부, 문자부, 하위정수부). 부모 정수 → 그 자식들 → 다음 정수 순."""
    m = PID_RE.match(pid)
    if not m:
        return (float('inf'), '', 0)
    return (int(m.group(1)), m.group(2) or '', int(m.group(3) or 0))


def parse_table(content):
    rows = []
    in_table = False
    idx = {}
    for line in content.split('\n'):
        if not line.startswith('|'):
            if in_table:
                break
            continue

        cols = [c.strip() for c in line.split('|')[1:-1]]

        if ':-' in line:
            continue

        # 헤더 행: id + color 컬럼 보유
        if 'id' in cols and any('color' in c.lower() for c in cols):
            idx['id']    = cols.index('id')
            idx['path']  = next((i for i, c in enumerate(cols) if c == '경로'), None)
            idx['emoji'] = next((i for i, c in enumerate(cols) if '이모지' in c), None)
            idx['color'] = next(i for i, c in enumerate(cols) if 'color' in c.lower())
            # Issue472 — 아이덴티티 수집기가 표시명·설명을 함께 쓴다(없으면 빈 문자열).
            idx['name']  = next((i for i, c in enumerate(cols) if '프로젝트명' in c), None)
            idx['desc']  = next((i for i, c in enumerate(cols) if c == '설명'), None)
            in_table = True
            continue

        if in_table:
            pid = cols[idx['id']] if idx['id'] < len(cols) else ''
            if not PID_RE.match(pid):
                continue
            path  = cols[idx['path']].strip('`')  if idx['path']  is not None and idx['path']  < len(cols) else ''
            emoji = cols[idx['emoji']]            if idx['emoji'] is not None and idx['emoji'] < len(cols) else ''
            color = cols[idx['color']]            if idx['color'] < len(cols) else ''
            name  = cols[idx['name']]             if idx.get('name')  is not None and idx['name']  < len(cols) else ''
            desc  = cols[idx['desc']]             if idx.get('desc')  is not None and idx['desc']  < len(cols) else ''
            # id 는 문자열로 보존 — 접미 id(9a)는 int 로 못 담고, 파일명이 곧 id 다.
            rows.append({'id': pid, 'path': path, 'emoji': emoji, 'color': color,
                         'name': name, 'desc': desc})

    return sorted(rows, key=lambda r: pid_sort_key(r['id']))


def readable_fg(hexcolor):
    """배경색 명도 기준 가독 전경색(어두움/밝음) 반환."""
    h = (hexcolor or '').lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    try:
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    except (ValueError, IndexError):
        return '#1f1f1f'
    lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255
    return '#15202b' if lum > 0.5 else '#e8e8e8'


def shade(hexcolor, ratio):
    """base 를 ratio(0~1) 만큼 검정 쪽으로 섞는다 — 파생 액센트 색 생성 (Issue494 ④).

    왜 도구가 소유하나: `activityBar.activeBackground`·`statusBarItem.hoverBackground`·
      `statusBar.debuggingBackground` 는 peacock 이 **구색에서 파생**해 써 넣는 값인데
      merge 집합 밖이라, 색을 바꿔도 구색 파생값이 남았다(prj101 라임 배경에 청회색
      `#bfbfce` hover — 2026-09-18 실측). Issue494_1 이 `titleBar.border`·`statusBar.border`
      에서 같은 문제를 겪고 «우회 대신 도구가 소유» 로 해결한 것과 같은 판정이다.
    파생식을 여기 고정하는 이유: peacock 의 내부 알고리즘을 추측해 흉내 내면 버전이
      바뀔 때마다 갈린다. **우리가 정한 식**을 문서와 함께 못박는다.
    """
    h = (hexcolor or '').lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    try:
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    except (ValueError, IndexError):
        return hexcolor
    f = lambda v: max(0, min(255, round(v * (1 - ratio))))
    return '#%02x%02x%02x' % (f(r), f(g), f(b))


def gen_projects(rows):
    """[1/4] projects/<id> 인덱스 파일 재생성 (기존 숫자 파일만 제거 후 재작성)."""
    os.makedirs(PROJECTS_DIR, exist_ok=True)

    # 가드 (Issue319): projects/<pid> 는 반드시 "경로 한 줄" 파일이어야 함.
    # 실물 프로젝트 디렉토리가 index 폴더에 잘못 들어오면(수동 mv/cp·에이전트 실수)
    # os.remove/open 이 IsADirectoryError 로 침묵 실패 → path 파일 재생성 불가.
    # 자동 rmtree 는 백업 없는 실물 삭제 위험이라 금지. fail-loud 중단만 함.
    path_by_id = {r['id']: r['path'] for r in rows}
    stray_dirs = [
        f for f in os.listdir(PROJECTS_DIR)
        if PID_RE.match(f) and os.path.isdir(os.path.join(PROJECTS_DIR, f))
    ]
    if stray_dirs:
        print('Error: projects/ 인덱스 폴더에 디렉토리가 존재함 (경로 파일이어야 함).',
              file=sys.stderr)
        print('  실물 프로젝트가 index 폴더에 잘못 배치된 것으로 보임. 자동 삭제하지 않음.',
              file=sys.stderr)
        for d in sorted(stray_dirs):
            target = path_by_id.get(d, '(Projects.md 에 정의 없음)')
            print(f'  - projects/{d}  →  올바른 위치: {target}', file=sys.stderr)
        print('  조치: 위 디렉토리 내용을 올바른 위치로 이동(mv) 후 재실행.', file=sys.stderr)
        sys.exit(2)

    for f in os.listdir(PROJECTS_DIR):
        # 인덱스 파일만 제거 — .frecency / .sync-stamp 등 부속 파일은 패턴 불일치로 보존됨.
        if PID_RE.match(f):
            os.remove(os.path.join(PROJECTS_DIR, f))
    n = 0
    for r in rows:
        if not r['path']:
            continue
        with open(os.path.join(PROJECTS_DIR, r['id']), 'w') as fh:
            fh.write(r['path'] + '\n')
        n += 1
    print(f'[1/4] projects/ 인덱스 {n}개 재생성')


EDITOR_YML = os.path.join(PM_ROOT, 'data', 'editor.yml')


def editor_cfg(key, default=''):
    """data/editor.yml flat key:value 조회 (Issue327). 파일·키 부재 시 default."""
    try:
        with open(EDITOR_YML, encoding='utf-8') as fh:
            for line in fh:
                m = re.match(r'\s*' + re.escape(key) + r'\s*:\s*(.*)$', line)
                if m:
                    v = re.sub(r'\s*#.*$', '', m.group(1)).strip()
                    return v or default
    except OSError:
        pass
    return default


def target_editors():
    """색을 반영할 에디터 목록. color_sync=off → 빈 목록(동기 skip)."""
    mode = editor_cfg('color_sync', 'all')
    if mode == 'off':
        return []
    if mode == 'default':
        return [editor_cfg('default_editor', 'vscode')]
    raw = editor_cfg('enabled_editors', 'vscode')
    return [e.strip() for e in raw.split(',') if e.strip()]


def _jsonc_blank_comments(raw):
    """JSONC 주석(`//`·`/* */`)을 같은 길이의 공백으로 치환한다 (Issue520).

    ⚠️ **문자열 리터럴 안의 `//` 는 건드리지 않는다** — URL(`http://…`)이 그 자리에 흔하다.
    길이와 줄 수를 그대로 보존하므로, 이 결과에서 얻은 오프셋을 **원문에 그대로 적용**할 수 있다.
    주석을 살린 채 값만 갈아끼우는 `_write_settings` 가 이 성질을 전제한다.
    """
    out = list(raw)
    i, n = 0, len(raw)
    in_str = esc = False
    while i < n:
        c = raw[i]
        if in_str:
            if esc:
                esc = False
            elif c == '\\':
                esc = True
            elif c == '"':
                in_str = False
            i += 1
            continue
        if c == '"':
            in_str = True
            i += 1
            continue
        if c == '/' and i + 1 < n:
            nxt = raw[i + 1]
            if nxt == '/':
                j = i
                while j < n and raw[j] != '\n':
                    out[j] = ' '
                    j += 1
                i = j
                continue
            if nxt == '*':
                end = raw.find('*/', i + 2)
                end = n if end < 0 else end + 2
                for j in range(i, end):
                    out[j] = '\n' if raw[j] == '\n' else ' '
                i = end
                continue
        i += 1
    return ''.join(out)


def _load_jsonc(path):
    """(data, ok, raw, blanked) — JSONC 설정 파일을 읽는다 (Issue520).

    VSCode·Zed 의 `settings.json` 은 **주석을 공식 허용하는 JSONC** 다. 표준 json 파서로 읽으면
    주석 한 줄에 그 프로젝트가 통째로 skip 되고 색 동기화가 조용히 끊긴다 — prj0(홈)이
    `#dddddd` 로 오래 남아 있던 원인이 이것이다. 주석을 지우라고 요구하는 것은 회피책이다.
    """
    if not os.path.isfile(path):
        return {}, True, '', ''
    raw = open(path, encoding='utf-8').read()
    blanked = _jsonc_blank_comments(raw)
    for text in (blanked, re.sub(r',(\s*[}\]])', r'\1', blanked)):
        try:
            return json.loads(text), True, raw, blanked
        except json.JSONDecodeError:
            continue
    return None, False, raw, blanked


def _load_json_lenient(path):
    """(data, ok) — 하위호환 래퍼. 본체는 `_load_jsonc`."""
    data, ok, _raw, _blanked = _load_jsonc(path)
    return data, ok


def _value_end(blanked, start):
    """`start` 에서 시작하는 JSON 값의 끝 오프셋(배타)."""
    n = len(blanked)
    c = blanked[start]
    if c in '{[':
        depth = 0
        i = start
        in_str = esc = False
        while i < n:
            ch = blanked[i]
            if in_str:
                if esc:
                    esc = False
                elif ch == '\\':
                    esc = True
                elif ch == '"':
                    in_str = False
            elif ch == '"':
                in_str = True
            elif ch in '{[':
                depth += 1
            elif ch in '}]':
                depth -= 1
                if depth == 0:
                    return i + 1
            i += 1
        return n
    if c == '"':
        i, esc = start + 1, False
        while i < n:
            ch = blanked[i]
            if esc:
                esc = False
            elif ch == '\\':
                esc = True
            elif ch == '"':
                return i + 1
            i += 1
        return n
    i = start
    while i < n and blanked[i] not in ',}\r\n':
        i += 1
    while i > start and blanked[i - 1] in ' \t':
        i -= 1
    return i


def _toplevel_value_span(blanked, key):
    """최상위 `"key"` 의 **값** 구간 `(start, end)`. 없으면 None.

    주석이 공백으로 지워진 텍스트를 훑으므로 주석 안에 적힌 가짜 키에 걸리지 않는다.
    """
    n = len(blanked)
    i = depth = 0
    in_str = esc = False
    tok = None
    while i < n:
        c = blanked[i]
        if in_str:
            if esc:
                esc = False
            elif c == '\\':
                esc = True
            elif c == '"':
                in_str = False
                if depth == 1 and tok is not None and blanked[tok + 1:i] == key:
                    j = i + 1
                    while j < n and blanked[j] in ' \t\r\n':
                        j += 1
                    if j < n and blanked[j] == ':':
                        j += 1
                        while j < n and blanked[j] in ' \t\r\n':
                            j += 1
                        return (j, _value_end(blanked, j))
                tok = None
            i += 1
            continue
        if c == '"':
            in_str = True
            tok = i
            i += 1
            continue
        if c in '{[':
            depth += 1
        elif c in '}]':
            depth -= 1
        i += 1
    return None


def _dump_at(val, indent):
    """값을 `indent` 열에 맞춰 직렬화한다 (둘째 줄부터 들여쓰기 접두)."""
    text = json.dumps(val, ensure_ascii=False, indent=2)
    if indent <= 0 or '\n' not in text:
        return text
    pad = ' ' * indent
    head, _, tail = text.partition('\n')
    return head + '\n' + '\n'.join(pad + ln for ln in tail.split('\n'))


def _write_settings(path, updates, data, raw, blanked):
    """설정 파일에 최상위 키를 반영한다. 주석이 있으면 **원문을 살려 값만 갈아끼운다** (Issue520).

    주석 없는 파일은 종전대로 전체 재작성한다(포맷 일관). 주석이 있으면 재작성이 곧 사용자
    주석 삭제이므로, 최상위 키의 값 구간만 splice 하고 나머지 바이트는 손대지 않는다.
    반환값은 `'ok'`(주석 보존 splice)·`'rewrite'`(전체 재작성)로, 호출부가 고지에 쓴다.
    """
    os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
    has_comments = bool(raw) and raw != blanked

    if has_comments:
        spans = []
        for key, val in updates.items():
            span = _toplevel_value_span(blanked, key)
            if span is None:
                spans = None
                break
            spans.append((span, val))
        if spans is not None:
            text = raw
            # 뒤에서부터 치환해야 앞 구간의 오프셋이 밀리지 않는다.
            for (s, e), val in sorted(spans, key=lambda t: -t[0][0]):
                line_start = text.rfind('\n', 0, s) + 1
                line = text[line_start:s]
                indent = len(line) - len(line.lstrip())
                text = text[:s] + _dump_at(val, indent) + text[e:]
            with open(path, 'w', encoding='utf-8') as fh:
                fh.write(text)
            return 'ok'

    for key, val in updates.items():
        data[key] = val
    with open(path, 'w', encoding='utf-8') as fh:
        json.dump(data, fh, ensure_ascii=False, indent=2)
        fh.write('\n')
    return 'rewrite' if has_comments else 'ok'


def reconcile_from_editors(rows, content):
    """[0/4] 역방향 동기 — .vscode/settings.json 이 Projects.md 보다 최신이면 그 색을 SSOT 로 되받는다.

    통상 방향은 Projects.md → 에디터 설정이다. 그러나 사용자가 VSCode 에서 peacock 으로 색을
    직접 고르면 최신 의도는 settings.json 쪽에 있고, 그대로 forward sync 를 돌리면 그 선택이
    조용히 덮여 사라진다. mtime 으로 어느 쪽이 나중 편집인지 판정해 방향을 뒤집는다.

    채택 조건 (모두 충족해야 함):
      1. `.vscode/settings.json` 이 존재하고 파싱 가능
      2. `peacock.color` 가 유효 hex
      3. Projects.md 의 color 와 실제로 다름
      4. settings.json mtime > Projects.md mtime

    반환: (갱신된 content, [(id, 이전색, 새색), ...]). 변경 없으면 원본 content 와 빈 리스트.
    """
    try:
        md_mtime = os.path.getmtime(PROJECTS_MD)
    except OSError:
        return content, []

    changes = []
    for r in rows:
        real = os.path.expanduser(r['path'])
        spath = os.path.join(real, '.vscode', 'settings.json')
        if not os.path.isfile(spath):
            continue
        if os.path.getmtime(spath) <= md_mtime:
            continue
        data, ok = _load_json_lenient(spath)
        if not ok or not isinstance(data, dict):
            continue
        newc = (data.get('peacock.color') or '').strip()
        if not re.match(r'^#[0-9a-fA-F]{3,6}$', newc):
            continue
        if newc.lower() == (r['color'] or '').lower():
            continue
        changes.append((r['id'], r['color'], newc))

    if not changes:
        return content, []

    # 표 행의 color 셀만 교체. 색상 hex 는 color 컬럼에만 등장하므로 행 단위 치환으로 충분하다.
    lines = content.split('\n')
    by_id = {cid: (old, new) for cid, old, new in changes}
    for i, line in enumerate(lines):
        if not line.startswith('|'):
            continue
        cols = [c.strip() for c in line.split('|')[1:-1]]
        if not cols:
            continue
        pid = cols[0]
        if pid not in by_id:
            continue
        old, new = by_id[pid]
        if old:
            lines[i] = line.replace(old, new, 1)
        else:
            continue
    return '\n'.join(lines), changes


def write_zed(real, base, fg, emoji):
    """.zed/settings.json 에 배경색 반영 (Issue327).

    Zed 는 peacock 같은 확장이 없어 `experimental.theme_overrides` 로 직접 칠한다.
    ⚠️ Zed 는 신뢰(trust)하지 않은 워크트리의 프로젝트 설정을 무시한다(Restricted Mode) —
       파일을 써도 사용자가 그 프로젝트를 1회 신뢰하기 전까지 색이 안 보인다.
    window.title 대응 키는 없어 이모지는 반영 대상이 아니다(능력 매트릭스 title_emoji 미지원).
    """
    zdir = os.path.join(real, '.zed')
    spath = os.path.join(zdir, 'settings.json')
    data, ok, raw, blanked = _load_jsonc(spath)
    if not ok:
        return 'skip'
    ov = data.get('experimental.theme_overrides', {}) or {}
    ov.update({
        'background':               base,
        'editor.background':        base,
        'panel.background':         base,
        'tab_bar.background':       base,
        'title_bar.background':     base,
        'status_bar.background':    base,
        'toolbar.background':       base,
    })
    os.makedirs(zdir, exist_ok=True)
    return _write_settings(spath, {'experimental.theme_overrides': ov},
                           data, raw, blanked)


def update_editors(rows):
    """[2/4] 각 프로젝트의 에디터 설정 파일에 배경색(+VSCode 는 이모지) 반영 (다른 키 보존).

    대상 에디터는 data/editor.yml 의 color_sync·enabled_editors 가 결정 (Issue327).
    """
    editors = target_editors()
    if not editors:
        print('[2/4] color_sync: off — 에디터 색 동기 skip')
        return
    touched = skipped = missing = 0
    zed_touched = zed_skipped = 0
    # Issue520 ③ — skip 사유를 중간 로그로만 흘리면 뒤 단계 출력에 묻힌다. 끝에 다시 모아 낸다.
    skip_notes = []
    do_vscode = 'vscode' in editors
    do_zed = 'zed' in editors
    for r in rows:
        real = os.path.expanduser(r['path'])
        if not os.path.isdir(real):
            missing += 1
            continue
        if not re.match(r'#[0-9a-fA-F]{3,6}$', r['color'] or ''):
            continue

        if do_zed:
            res = write_zed(real, r['color'], readable_fg(r['color']), r['emoji'])
            if res == 'ok':
                zed_touched += 1
            else:
                zed_skipped += 1
                skip_notes.append((os.path.join(real, '.zed', 'settings.json'),
                                   'JSON 문법 오류 — 주석·trailing comma 를 지운 뒤에도 파싱 불가'))

        if not do_vscode:
            continue

        vsdir = os.path.join(real, '.vscode')
        settings_path = os.path.join(vsdir, 'settings.json')

        # VSCode settings.json 은 JSONC — 주석·trailing comma 가 정상 문법이다 (Issue520).
        data, ok, raw, blanked = _load_jsonc(settings_path)
        if not ok:
            skip_notes.append((settings_path, 'JSON 문법 오류 — 주석·trailing comma 를 지운 뒤에도 파싱 불가'))
            skipped += 1
            continue

        base = r['color']
        fg = readable_fg(base)

        # peacock 가 색칠하는 배경 키만 merge (기존 colorCustomizations 다른 키 보존)
        cc = data.get('workbench.colorCustomizations', {}) or {}
        cc.update({
            'titleBar.activeBackground':     base,
            'titleBar.activeForeground':     fg,
            'titleBar.inactiveBackground':   base + '99',
            'titleBar.inactiveForeground':   fg + '99',
            # Issue494: peacock 가 base 와 같은 값으로 칠하는 테두리 2종. 여기 빠져 있어
            # 색 교체 후에도 구색 hairline 이 남았다(prj16·25·42·71·101 에서 실측).
            'titleBar.border':               base,
            'statusBar.border':              base,
            'activityBar.background':        base,
            'activityBar.foreground':        fg,
            'statusBar.background':          base,
            'statusBar.foreground':          fg,
            'statusBarItem.remoteBackground': base,
            'statusBarItem.remoteForeground': fg,
            # Issue494 ④: peacock 이 구색에서 파생해 남기던 액센트 3종. 도구가 소유한다 —
            #   merge 집합 밖이면 배경만 바뀌고 파생값은 구색으로 남아 색이 뒤섞인다.
            'activityBar.activeBackground':   shade(base, 0.12),
            'statusBarItem.hoverBackground':  shade(base, 0.12),
            'statusBar.debuggingBackground':  shade(base, 0.22),
        })
        updates = {'workbench.colorCustomizations': cc, 'peacock.color': base}
        if r['emoji']:
            updates['window.title'] = f"{r['emoji']} ${{rootName}}${{separator}}${{activeEditorShort}}"

        os.makedirs(vsdir, exist_ok=True)
        res = _write_settings(settings_path, updates, data, raw, blanked)
        if res == 'rewrite':
            # 주석이 있는데 갈아끼울 키가 없어 전체 재작성했다 — 주석이 사라진 사실을 고지한다.
            skip_notes.append((settings_path, '주석 보존 실패 — 키 신설이 필요해 전체 재작성했고 주석이 사라졌다'))
        touched += 1

    parts = []
    if do_vscode:
        parts.append(f'.vscode {touched}개(파싱skip {skipped})')
    if do_zed:
        parts.append(f'.zed {zed_touched}개(파싱skip {zed_skipped})')
    print(f"[2/4] 에디터 설정 갱신 — {' / '.join(parts)} (디렉토리 없음 {missing})")
    for path, why in skip_notes:
        print(f'  ⚠️ {path}\n     └ {why}')


def run_iterm():
    """[3/4] iterm-bg alias 재생성 위임."""
    if os.access(UPDATE_ITERM, os.X_OK):
        subprocess.run([sys.executable, UPDATE_ITERM], check=False)
        print('[3/4] iterm-bg alias 재생성 (sh/update-iterm-bg)')
    else:
        print(f'[3/4] skip — {UPDATE_ITERM} 실행 불가')


def run_identity():
    """[4/4] Identity.md 아이덴티티 집계 재생성 위임 (Issue472).

    각 프로젝트 CLAUDE.md frontmatter 를 읽기만 한다 — 타 repo 에 쓰지 않는다.
    """
    if os.access(IDENTITY_COL, os.X_OK):
        subprocess.run([sys.executable, IDENTITY_COL], check=False)
    else:
        print(f'[4/4] skip — {IDENTITY_COL} 실행 불가')


def main():
    index_only = '--index-only' in sys.argv[1:]
    no_reverse = '--no-reverse' in sys.argv[1:]

    with open(PROJECTS_MD, encoding='utf-8') as f:
        content = f.read()

    rows = parse_table(content)
    if not rows:
        print('Error: Projects.md 테이블 파싱 실패 (id/color 헤더 확인)', file=sys.stderr)
        sys.exit(1)

    # [0/4] 역방향 동기 — 에디터 설정이 더 최신이면 그 색을 SSOT 로 되받은 뒤 forward 진행.
    if not (index_only or no_reverse):
        new_content, changes = reconcile_from_editors(rows, content)
        if changes:
            with open(PROJECTS_MD, 'w', encoding='utf-8') as f:
                f.write(new_content)
            for cid, old, new in changes:
                print(f'[0/4] 역방향 반영 — prj{cid}: {old} → {new} (.vscode/settings.json 이 더 최신)')
            content = new_content
            rows = parse_table(content)

    gen_projects(rows)
    if index_only:
        # pre-commit hook 용 — 이 repo 추적 산출물(projects/)만 재생성.
        # .vscode(타 repo)·iterm(로컬·gitignore)은 커밋과 무관하므로 skip.
        print(f'✅ fpm-projects-sync --index-only 완료 — {len(rows)}개 프로젝트 (projects/ 만)')
        return

    update_editors(rows)
    run_iterm()
    run_identity()
    print(f'✅ fpm-projects-sync 완료 — {len(rows)}개 프로젝트')


if __name__ == '__main__':
    main()
