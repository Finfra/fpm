def esc(v):
    return (v or '').replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')


def card_html(rec, nodes, today):
    f = rec['fields']
    idt = f.get('identity', '').strip()
    empty = not idt
    body = [f'''<div class="card{" empty" if empty else ""}">''']
    body.append('<div class="hd"><span class="em">{}</span><span class="nm">{}</span>'
                '<span class="id">prj{}</span></div>'.format(
                    esc(rec['emoji']), esc(rec['name']), esc(rec['id'])))

    if rec['note']:
        body.append(f'<div class="idt miss">{esc(rec["note"])}</div>')
    elif empty:
        body.append(f'<div class="idt miss">{MISSING}</div>')
        if rec.get('desc'):
            body.append(f'<div class="not" style="opacity:.7">Projects.md: {esc(rec["desc"])}</div>')
    else:
        body.append(f'<div class="idt">{esc(idt)}</div>')
        if f.get('not'):
            body.append(f'<div class="not">{esc(f["not"])}</div>')
        if f.get('identity_origin'):
            body.append('<div class="org">처음엔 — {}</div>'.format(esc(f['identity_origin'])))
        if f.get('outcome'):
            body.append(f'<div class="out">{esc(f["outcome"])}</div>')

    tags = []
    lt = f.get('lifetime', '')
    if lt == 'perpetual':
        tags.append('<span class="tag perp">영속형</span>')
    elif lt == 'finite':
        dl = f.get('deadline', '')
        sun = sunset_flag(rec, today)
        tags.append('<span class="tag fin">유한형{}</span>'.format(f' · {esc(dl)}' if dl else ''))
        if sun:
            tags.append('<span class="tag sun">🌅 시한 경과</span>')
    st = f.get('status', '')
    if st and st != 'active':
        tags.append(f'<span class="tag">{esc(st)}</span>')
    if tags:
        body.append('<div class="tags">' + ''.join(tags) + '</div>')
    body.append('</div>')
    return ''.join(body)


def render_htm(recs, nodes):
    """목적 부모별 그룹의 카드 그리드. 알림 없음 — 볼 때 보이는 표면일 뿐이다(조항 6)."""
    today = datetime.date.today()
    ts = today.strftime('%Y.%m.%d')
    filled = sum(1 for r in recs if r['fields'].get('identity'))

    groups = {}
    for r in recs:
        g = r['fields'].get('goal_parent', '').strip() or '미할당'
        if g not in nodes and g != '미할당':
            g = f'{g} ⚠️'
        groups.setdefault(g, []).append(r)

    def gkey(name):
        return (1 if name.startswith('미할당') else 0, name)

    H = ['<!doctype html><html lang="ko"><head><meta charset="utf-8">',
         '<meta name="viewport" content="width=device-width,initial-scale=1">',
         '<title>Identity Map</title><style>', CSS, '</style></head><body>',
         '<h1>🎯 프로젝트 아이덴티티</h1>',
         '<div class="sub">기재 <b>{}/{}</b> · 생성 {} · 재생성 <code>sh/fpm-identity-collect</code>'
         ' — 값은 각 프로젝트 <code>CLAUDE.md</code> frontmatter 가 소유합니다</div>'.format(
             filled, len(recs), ts)]

    for g in sorted(groups, key=gkey):
        rs = groups[g]
        n = sum(1 for r in rs if r['fields'].get('identity'))
        H.append(f'<h2>{esc(g)} <span class="n">{n}/{len(rs)}</span></h2><div class="grid">')
        H += [card_html(r, nodes, today) for r in rs]
        H.append('</div>')

    H.append('<footer>⚠️ <b>미기재는 오류가 아닙니다</b> — 아직 정하지 않았다는 신호입니다. '
             '<b>🌅 는 표시일 뿐 일몰 발의가 아닙니다</b> — 발의는 prj6 <code>8.sunset/</code>, '
             '집행은 사람입니다(조항 5·6). 이 페이지는 알림을 보내지 않습니다.</footer>')
    H.append('</body></html>')
    return '\n'.join(H)


def main():
    check = '--check' in sys.argv[1:]
    recs, nodes = collect()
    text = render(recs, nodes)
    filled = sum(1 for r in recs if r['fields'].get('identity'))
    if check:
        print(f'[identity] 기재 {filled}/{len(recs)} — 미기재 {len(recs) - filled} (쓰지 않음)')
        return 0
    with open(OUT_MD, 'w', encoding='utf-8') as f:
        f.write(text)
    made = 'Identity.md'
    if '--md-only' not in sys.argv[1:]:
        with open(OUT_HTM, 'w', encoding='utf-8') as f:
            f.write(render_htm(recs, nodes))
        made += ' + Identity_map.htm'
    print(f'[4/4] {made} 생성 — 기재 {filled}/{len(recs)}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
